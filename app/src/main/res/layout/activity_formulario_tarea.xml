<?xml version="1.0" encoding="utf-8"?>


    <LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tituloFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:text="Nueva tarea"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/texto_oscuro"
            android:textSize="26sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Nombre de la tarea *"
            android:textColor="@color/texto_oscuro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nombreTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/blanco"
            android:hint="Escribe el nombre de la tarea"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/texto_oscuro"
            android:textColorHint="@color/texto_suave" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Categoría *"
            android:textColor="@color/texto_oscuro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_principal"
            android:padding="12dp"
            android:text="Seleccionar categoría"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Sin seleccionar"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Fecha *"
            android:textColor="@color/texto_oscuro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/SeleccionarFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_principal"
            android:padding="12dp"
            android:text="Seleccionar fecha"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Sin seleccionar"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Hora *"
            android:textColor="@color/texto_oscuro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_principal"
            android:padding="12dp"
            android:text="Seleccionar hora"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/hora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Sin seleccionar"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/color_principal"
                android:padding="12dp"
                android:text="Guardar"
                android:textColor="@color/blanco" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/texto_suave"
                android:padding="12dp"
                android:text="Cancelar"
                android:textColor="@color/blanco" />

        </LinearLayout>

    </LinearLayout>
